    {
      "name": "Role-Based Authorization Tests",
      "item": [
        {
          "name": "Employee Test Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employee/test",
              "host": ["{{baseUrl}}"],
              "path": ["employee", "test"]
            },
            "description": "Accessible by EMPLOYEE, ENGINEER, MANAGER, and ADMIN. Returns 200 OK if authenticated with any of these roles, or 401 if unauthenticated."
          }
        },
        {
          "name": "Engineer Test Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/engineer/test",
              "host": ["{{baseUrl}}"],
              "path": ["engineer", "test"]
            },
            "description": "Accessible by ENGINEER and ADMIN. Returns 200 OK for Engineer/Admin; returns 403 Forbidden for Employee or Manager."
          }
        },
        {
          "name": "Manager Test Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/manager/test",
              "host": ["{{baseUrl}}"],
              "path": ["manager", "test"]
            },
            "description": "Accessible by MANAGER and ADMIN. Returns 200 OK for Manager/Admin; returns 403 Forbidden for Employee or Engineer."
          }
        },
        {
          "name": "Admin Test Endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/test",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "test"]
            },
            "description": "Accessible by ADMIN only. Returns 200 OK for Admin; returns 403 Forbidden for Employee, Engineer, or Manager."
          }
        }
      ]
    }
