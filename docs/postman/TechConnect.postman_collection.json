    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"ticketId\", jsonData.id.toString());",
                  "    console.log(\"Saved created ticket ID to {{ticketId}}\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VPN connection drops unexpectedly\",\n  \"description\": \"Every 10-15 minutes the Cisco AnyConnect VPN disconnects when working remotely.\",\n  \"category\": \"VPN\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"]
            },
            "description": "Creates a new ticket in OPEN status. Requester identity is automatically derived from the authenticated JWT."
          }
        },
        {
          "name": "Get My Tickets (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets/my?page=0&size=10&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "my"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "createdAt,desc"
                },
                {
                  "key": "status",
                  "value": "OPEN",
                  "disabled": true
                },
                {
                  "key": "priority",
                  "value": "HIGH",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "VPN",
                  "disabled": true
                }
              ]
            },
            "description": "Returns role-scoped paginated tickets (Employees see created tickets; Engineers see assigned tickets; Managers see team tickets; Admins see all tickets)."
          }
        },
        {
          "name": "Get Ticket By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}"]
            },
            "description": "Retrieves comprehensive ticket details. Subject to role and ownership authorization."
          }
        },
        {
          "name": "Update Ticket Details",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VPN connection drops unexpectedly on macOS Sequoia\",\n  \"priority\": \"CRITICAL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}"]
            },
            "description": "Updates permitted ticket fields. Employees can only update OPEN tickets; Engineers/Managers/Admins have role-scoped permissions."
          }
        }
      ]
    },
    {
      "name": "Status",
      "item": [
        {
          "name": "Change Ticket Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"reason\": \"Investigating gateway logs\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "status"]
            },
            "description": "Transitions ticket status according to the valid workflow state machine. Generates TicketStatusHistory and AuditLog."
          }
        },
        {
          "name": "Get Ticket Status History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "history"]
            },
            "description": "Returns full chronological timeline of status transitions for the specified ticket."
          }
        }
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {
          "name": "Assign Engineer",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"engineerId\": 2,\n  \"notes\": \"Assigned to network specialist for triage\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/assignment",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "assignment"]
            },
            "description": "Assigns an IT engineer to the ticket. Transitions ticket to ASSIGNED if currently OPEN. Accessible by Managers, Admins, and Engineers (self-assignment)."
          }
        },
        {
          "name": "Get Ticket Assignment History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/assignments",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "assignments"]
            },
            "description": "Returns audit trail of past engineer and team assignments for this ticket."
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment to Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"I have verified that restarting the gateway resolved the issue.\",\n  \"isInternal\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "comments"]
            },
            "description": "Adds a comment to the ticket. Employees can only add public comments. Internal comments are restricted to IT staff."
          }
        },
        {
          "name": "Get Ticket Comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["tickets", "{{ticketId}}", "comments"]
            },
            "description": "Returns chronological comments for the ticket. Employees receive only public comments; staff receive public and internal comments."
          }
        }
      ]
    },
