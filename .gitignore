# ==========================================
# TechConnect Enterprise .gitignore
# ==========================================

# Secrets and environment configs
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Java & Maven
target/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar

# Node & Frontend
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & AI Services
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
env/
venv/
ENV/
*.egg-info/
.pytest_cache/

# IDE and Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.project
.classpath
.settings/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini
