# ==============================================================================
# TechConnect Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with actual secrets.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=techconnect_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password

# MongoDB (Knowledge Base & AI Documents)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=techconnect_kb
MONGO_USER=mongo_admin
MONGO_PASSWORD=your_secure_mongo_password

# JWT Authentication
JWT_SECRET=your_base64_encoded_256bit_minimum_secret_key_here
JWT_EXPIRATION_MS=86400000

# Development Baseline Seeding (Keep TECHCONNECT_SEED_DEV_USERS=false in production)
# When set to true in local development, you MUST provide your own development password below.
# The application will fail to start if TECHCONNECT_SEED_DEV_USERS=true and TECHCONNECT_DEV_PASSWORD is empty.
TECHCONNECT_SEED_DEV_USERS=true
TECHCONNECT_DEV_PASSWORD=



# ------------------------------------------------------------------------------
# AI Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8001
AI_SERVICE_HOST=localhost
OPENAI_API_KEY=your_openai_or_gemini_api_key_if_applicable

# ------------------------------------------------------------------------------
# Frontend Configuration (React)
# ------------------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:8080/api
