# ==============================================================================
# TechConnect Enterprise Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this template to a file named '.env' in your local deployment environment.
# 2. Populate each variable with appropriate credentials for your target environment.
# 3. NEVER commit '.env' or real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL & PGVECTOR CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=techconnect_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_MAX_POOL_SIZE=20
POSTGRES_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 2. MONGODB CONFIGURATION (KNOWLEDGE BASE & AUDIT DOCUMENTS)
# ------------------------------------------------------------------------------
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DB=techconnect_knowledge
MONGODB_USER=techconnect_mongo_user
MONGODB_PASSWORD=replace_with_secure_mongo_password
MONGODB_URI=mongodb://${MONGODB_USER}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DB}?authSource=admin

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Minimum 256-bit (32+ characters) cryptographically secure secret
JWT_SECRET=replace_with_256bit_cryptographically_secure_random_jwt_secret_key_base64
JWT_EXPIRATION_MS=3600000

# ------------------------------------------------------------------------------
# 4. SPRING BOOT BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
TECHCONNECT_SEED_DEV_USERS=false
TECHCONNECT_DEV_PASSWORD=

# ------------------------------------------------------------------------------
# 5. AI MICROSERVICE & FASTAPI CONFIGURATION
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=5000
COPILOT_TIMEOUT_MS=10000
RESOLUTION_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 6. LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
TECHCONNECT_LLM_PROVIDER=extractive
TECHCONNECT_LLM_API_KEY=replace_with_llm_api_key_if_using_external_provider
TECHCONNECT_LLM_MODEL=grounded-extractive-v1
TECHCONNECT_LLM_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 7. CORS & NETWORK RESTRICTIONS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser access
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & ABUSE PROTECTION
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# AI Copilot & Resolution endpoint rate limits (requests per minute per client)
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=20
# Knowledge Base search rate limit (requests per minute per client)
RATE_LIMIT_SEARCH_REQUESTS_PER_MINUTE=60
# General API rate limit (requests per minute per client)
RATE_LIMIT_GENERAL_REQUESTS_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 9. FRONTEND CONFIGURATION (REACT / VITE)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
